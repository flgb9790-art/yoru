{
  "name": "yoru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "build:brand": "node scripts/build-brand.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hls.js": "1.7.3",
    "jose": "^6.2.12",
    "kodikwrapper": "^3.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1"
  }
}
